# Copy this file to ".env" and fill in your own values. Never commit ".env".
# Vite makes every VITE_ variable visible to anyone who visits the site,
# so only PUBLIC values belong here. NEVER put the Supabase secret key here.

# Your Supabase project URL, with NO path on the end (not .../rest/v1/).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLISHABLE key (starts with sb_publishable_). Safe to expose; it is only
# powerful if your Row Level Security policies are in place.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: the largest image (in MB) the admin forms accept before uploading.
# Must match MAX_IMAGE_BYTES in backend/.env (default 5).
# VITE_MAX_IMAGE_MB=5
