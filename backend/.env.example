# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Your Supabase project URL, with NO path on the end (not .../rest/v1/).
SUPABASE_URL=https://your-project-ref.supabase.co

# The SECRET key (starts with sb_secret_). Server only: it bypasses all database
# security. Never put it in the frontend or in a VITE_ variable.
SUPABASE_SECRET_KEY=

# The email address of the ONE admin. Only the signed-in user with this email may
# add, change or delete content or read contact messages. If this is missing, all
# admin requests are refused.
ADMIN_EMAIL=your-admin-email@example.com

# The address of the frontend that may call this API from a browser.
# Separate several addresses with commas. Never use *.
FRONTEND_URL=http://localhost:5173

# Optional: the port the API listens on (default 5000).
# PORT=5000
